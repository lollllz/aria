# ── Frontend (Vite) ─────────────────────────────────────────────────────────
# Base URL of the Netlify API. Leave empty for local dev (same origin via `netlify dev`).
# In production this is your Netlify site, e.g. https://aria-api.netlify.app
VITE_API_BASE=

# Repo subpath for GitHub Pages project sites (https://<user>.github.io/<repo>/).
# The CI workflow sets this to "/<repo>/"; leave "/" for local dev / user sites.
VITE_BASE=/

# ── Server (Netlify Functions — set in Netlify dashboard, NEVER commit real values) ──
# Neon connection string (Dashboard → your project → Connection string → "Pooled").
DATABASE_URL=postgres://user:pass@ep-xxxx-pooler.region.aws.neon.tech/aria?sslmode=require
# Your GitHub Pages origin, for CORS (e.g. https://yourname.github.io)
ALLOWED_ORIGIN=https://yourname.github.io
